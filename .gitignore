# ============================================================
# 白名单模式：默认忽略所有新文件，只保留可复现构建和打包所需内容。
# 已经被 Git 跟踪的文件不会因为这里的规则自动删除。
# ============================================================
*

# 忽略规则本身
!/.gitignore

# Gradle / ForgeGradle 构建入口
!/build.gradle
!/gradle.properties
!/settings.gradle
!/gradlew
!/gradlew.bat

# Gradle Wrapper：保证其他环境可以直接使用项目指定的 Gradle
!/gradle/
!/gradle/wrapper/
!/gradle/wrapper/gradle-wrapper.jar
!/gradle/wrapper/gradle-wrapper.properties

# 模组源码与正式资源：这些内容会进入开发运行或最终 JAR
!/src/
!/src/main/
!/src/main/**

# 单元测试源码：与已跟踪的测试保持一致，新增测试用例应能随源码一起交付
!/src/test/
!/src/test/**

# 根目录 JAR 任务显式打包的许可与声明文件
!/LICENSE
!/NOTICE
!/LICENSE-MAP.md
!/DISCLAIMER.md
!/数据包兼容写法教程.md
